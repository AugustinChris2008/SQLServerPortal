# Demo oder SqlServer. Für den Datenbanktest: SqlServer.
SQLPORTAL_DATA_SOURCE=SqlServer

# Die Instanz Kathi lauscht auf TCP 1433. Der FQDN mit festem Port vermeidet eine
# Abhängigkeit vom SQL Browser (UDP 1434) und ist für Kerberos eindeutig.
# TrustServerCertificate=True ist für den ersten internen Test vorgesehen. Später das Firmen-CA-Zertifikat nutzen.
SQLPORTAL_CONNECTION_STRING='Server=tcp:DEZANT101V.intern.zollner.de,1433;Database=ZZImportTest;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;ApplicationIntent=ReadOnly;Connect Timeout=10;Application Name=SQL Operations Portal'

# Vollständiger AD-UPN. Das Kerberos-Realm wird in Großbuchstaben konfiguriert.
SQLPORTAL_KERBEROS_PRINCIPAL=SqlPortal@INTERN.ZOLLNER.DE

# Nur für compose.kerberos.yaml. Keytab und krb5.conf niemals in Git ablegen.
SQLPORTAL_KRB5_CONFIG_PATH=C:/secure/sqlportal/krb5.conf
SQLPORTAL_KEYTAB_PATH=C:/secure/sqlportal/sqlportal.keytab
# Alternative zur Keytab: lokale Datei mit nur dem Kennwort, außerhalb des Repositories.
SQLPORTAL_PASSWORD_FILE_PATH=C:/secure/sqlportal/sqlportal.password


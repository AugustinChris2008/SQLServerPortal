# Demo oder SqlServer. Für den Datenbanktest: SqlServer.
SQLPORTAL_DATA_SOURCE=SqlServer

# Die Instanz Kathi lauscht auf TCP 1433. Der feste Port vermeidet eine
# Abhängigkeit vom SQL Browser (UDP 1434).
# TrustServerCertificate=True ist für den ersten internen Test vorgesehen. Später das Firmen-CA-Zertifikat nutzen.
# SQLPORTAL_PASSWORD durch das echte Kennwort ersetzen. Die lokale .env wird nicht in Git eingecheckt.
SQLPORTAL_CONNECTION_STRING='Server=tcp:DEZANT101V,1433;Database=ZZImportTest;User ID=SqlPortal;Password=SQLPORTAL_PASSWORD;Encrypt=True;TrustServerCertificate=True;ApplicationIntent=ReadOnly;Connect Timeout=10;Application Name=SQL Operations Portal'


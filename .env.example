# Demo oder SqlServer
SQLPORTAL_DATA_SOURCE=Demo

# Nur für SqlServer erforderlich. Nicht in Git einchecken.
# ApplicationIntent=ReadOnly unterstützt Read-only-Routing, ersetzt aber keine SELECT-only-Berechtigung.
SQLPORTAL_CONNECTION_STRING=Server=tcp:sql.example.internal,1433;Database=SqlPortal;User ID=sqlportal_reader;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=False;ApplicationIntent=ReadOnly;Application Name=SQL Operations Portal

